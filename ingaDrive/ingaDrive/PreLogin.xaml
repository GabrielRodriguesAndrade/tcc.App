<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://xamarin.com/schemas/2014/forms"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             NavigationPage.HasNavigationBar="False"
              BackgroundColor="White"
             x:Class="ingaDrive.PreLogin">
    <ContentPage.Content>
        <StackLayout>
            <StackLayout Padding="160" VerticalOptions="Start" HorizontalOptions="Center">
                
            </StackLayout>
            
            
            <Button x:Name="btnCadastrar" Text="CADASTRAR-SE" BackgroundColor="Gray" Margin="30,0,30,0" TextColor="White" Clicked="btnCadastrar_Clicked"/>
            <Label Text="Já tem uma conta?" FontSize="Body" FontAttributes="Italic" TextColor="DarkOrange" HorizontalOptions="Center"/>
            <Button x:Name="btnLogin" Text="FAZER LOGIN" BackgroundColor="DarkOrange" Margin="30,0,30,0" TextColor="White" Clicked="btnLogin_Clicked"/>
        </StackLayout>
    </ContentPage.Content>
</ContentPage>