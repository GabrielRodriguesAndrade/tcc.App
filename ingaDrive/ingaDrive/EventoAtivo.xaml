<?xml version="1.0" encoding="utf-8" ?>
<TabbedPage xmlns="http://xamarin.com/schemas/2014/forms"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             NavigationPage.HasNavigationBar="False"   
             BackgroundColor="White"
             BarBackgroundColor="Black"
             SelectedTabColor="DarkOrange"
             UnselectedTabColor="Gray"
             x:Class="ingaDrive.EventoAtivo">
    
    <ContentPage Title="ENTRADA">
        <ContentPage.Content>
            <StackLayout Margin="0,50,0,0">
                <Label Text="MOTORISTA:" FontSize="Body" FontAttributes="Bold" HorizontalOptions="Center" TextColor="Black"/>
                <Entry x:Name="txtMotorista" Keyboard="Default" ReturnType="Next"
                   ClearButtonVisibility="WhileEditing" TextColor="Black" Margin="30,0,30,0"/>

                <Label Text="PLACA:" FontSize="Body" FontAttributes="Bold" HorizontalOptions="Center" TextColor="Black"/>
                <Entry x:Name="txtPlacas" Keyboard="Text" ReturnType="Next"
                   ClearButtonVisibility="WhileEditing" TextColor="Black" Margin="30,0,30,0"/>

                <Label Text="MODELO DO CARRO:" FontSize="Body" FontAttributes="Bold" HorizontalOptions="Center" TextColor="Black"/>
                <Entry x:Name="txtModelo" Keyboard="Text" ReturnType="Next"
                   ClearButtonVisibility="WhileEditing" TextColor="Black" Margin="30,0,30,0"/>
                
                <Label Text="VAGA DESTINADA:" FontSize="Body" FontAttributes="Bold" HorizontalOptions="Center" TextColor="Black"/>
                <Entry x:Name="txtVaga" Keyboard="Text" ReturnType="Next"
                   ClearButtonVisibility="WhileEditing" TextColor="Black" Margin="30,0,30,0"/>

                <Button x:Name="btnRegistrar" Text="REGISTRAR" BackgroundColor="DarkOrange" Margin="30,50,30,0" TextColor="White" Clicked="btnRegistrar_Clicked"/>
                <Button x:Name="btnCancelar" Text="CANCELAR" BackgroundColor="Gray" Margin="30,0,30,0" TextColor="White" Clicked="btnCancelar_Clicked"/>
            </StackLayout>
        </ContentPage.Content>
    </ContentPage>

    <ContentPage Title="SAÍDA">
        <ContentPage.Content>
            <StackLayout Margin="0,50,0,0" >
                <Label Text="PLACA:" FontSize="Body" FontAttributes="Bold" HorizontalOptions="Center" TextColor="Black"/>
                <Entry x:Name="txtPlaca" Keyboard="Text" ReturnType="Next"
                   ClearButtonVisibility="WhileEditing" TextColor="Black" Margin="30,0,30,0"/>

                <Button CornerRadius="15" Margin="30,40,30,0" Text="REGISTRAR SAÍDA" BackgroundColor="DarkOrange"
                        TextColor="White"/>

            </StackLayout>
        </ContentPage.Content>
    </ContentPage>

    <ContentPage Title="MONITORAMENTO">
        <ContentPage.Content>
            <StackLayout>
                <StackLayout Margin="0,20,0,0">
                    <Label Text="setor A:" TextColor="Black" FontSize="Title" HorizontalOptions="CenterAndExpand"/>
                    <Label Text="vagas disponíveis:32" TextColor="Black" FontSize="Medium" HorizontalOptions="CenterAndExpand"/>
                </StackLayout>
                <CollectionView x:Name="clvGaragem" Margin="10" HorizontalOptions="Center">
                    <CollectionView.ItemTemplate>
                        <DataTemplate>
                            <StackLayout>
                                <Frame BorderColor="Black" HasShadow="False" CornerRadius="5" Margin="5">
                                    <Frame.GestureRecognizers>
                                        <TapGestureRecognizer  Tapped="TapGestureRecognizer_Tapped" />
                                    </Frame.GestureRecognizers>
                                    <StackLayout>
                                        <Label Text="{Binding vaga}" TextColor="Black" FontSize="Body" HorizontalTextAlignment="Start"/>
                                        <Label Text="{Binding carro}" TextColor="Black" FontSize="Body" HorizontalTextAlignment="Start"/>
                                    </StackLayout>
                                </Frame>
                            </StackLayout>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>
            </StackLayout>
        </ContentPage.Content>
    </ContentPage>
</TabbedPage>